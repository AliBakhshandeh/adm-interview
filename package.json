{
  "name": "adm-interview-form-platform",
  "private": true,
  "version": "0.1.0",
  "description": "Metadata-driven enterprise form platform challenge implementation.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @admiral/showcase dev",
    "dev:showcase": "pnpm --filter @admiral/showcase dev",
    "preview": "pnpm --filter @admiral/showcase preview",
    "preview:showcase": "pnpm --filter @admiral/showcase preview",
    "test": "turbo run test",
    "test:platform": "pnpm --filter @admiral/form-platform test",
    "test:cli": "pnpm --filter @admiral/form-cli test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "storybook": "pnpm --filter @admiral/showcase storybook",
    "storybook:build": "CI=1 pnpm --filter @admiral/showcase build-storybook",
    "storybook:preview": "pnpm --filter @admiral/showcase storybook",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "generate": "pnpm --filter @admiral/form-cli build && node packages/form-cli/dist/index.js generate",
    "generate:multi-step": "pnpm --filter @admiral/form-cli build && sh -c 'node packages/form-cli/dist/index.js generate \"$1\" --template multi-step' --",
    "docs": "printf 'Open docs/index.md\\n'",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "verify": "pnpm build && pnpm typecheck && pnpm test && pnpm e2e && pnpm bundle:budget && pnpm storybook:build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.45.3",
    "@storybook/addon-essentials": "8.2.9",
    "@storybook/addon-interactions": "8.2.9",
    "@storybook/react": "8.2.9",
    "@storybook/react-vite": "8.2.9",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.8.0",
    "globals": "^17.8.0",
    "jsdom": "^24.1.1",
    "storybook": "8.2.9",
    "tsup": "^8.2.3",
    "tsx": "^4.16.2",
    "turbo": "^2.0.9",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.3.5",
    "vitest": "^2.0.4"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  }
}
